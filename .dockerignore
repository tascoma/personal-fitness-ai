.git/
.gitignore
.venv/
.python-version
.pytest_cache/
.claude/
.vscode/
.idea/

# Python build artifacts
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd

# Frontend deploys separately as its own Render static site
frontend/

# Local-only data and logs
.env
*.db
backend/logs/*
!backend/logs/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# Tests are not needed at runtime
backend/tests/

# Docs and editor files
*.md
!README.md
.DS_Store

# iOS app — not part of the server image
ios/
